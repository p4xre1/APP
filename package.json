{
  "name": "fatorati-offline",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/legal-content.mjs && vite build",
    "legal:build": "node scripts/legal-content.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/version.mjs",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser-check.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:start": "pnpm build && electron .",
    "desktop:dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-native-biometric": "^8.7.0",
    "jspdf": "^4.2.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "write-excel-file": "^4.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.4",
    "playwright": "1.61.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.5"
  },
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "^11.1.1"
    },
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.fatorati.desktop",
    "productName": "Fatorati",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
